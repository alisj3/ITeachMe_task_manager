WEBHOOK_SECRET=db19498aa99413196dd2aecbebe829bae4e5f3d16b353405ff77e9ccfd5e9aec

NODE_ENV=development
PORT=4000

# Origin of the frontend, for CORS (only needed if frontend is deployed separately)
FRONTEND_ORIGIN=http://localhost:5173
