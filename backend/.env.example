# Secret used to sign session JWTs — generate with: openssl rand -hex 32
JWT_SECRET=002d76fe2c22df3b439dbaa2a4579c13fd7d998b782a41cc5daa0c0bc1735f61

# Secret shared with external systems that send webhooks INTO this app
